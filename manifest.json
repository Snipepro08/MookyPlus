{
  "manifest_version": 3,
  "name": "MookyPlus",
  "version": "2.0",
  "description": "Customisation et fonctionnalités avancées pour Mooky.live",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.mooky.live/*"
  ],
  "action": {
    "default_title": "MookyPlus"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.mooky.live/*"
      ],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["logo.jpg"],
      "matches": ["*://*.mooky.live/*"]
    }
  ]
}
