{
  "manifest_version": 3,
  "name": "MookyPlus",
  "version": "1.0",
  "description": "Extension pour personnaliser l'interface du site Mooky.live",
  "icons": {
    "16": "logo.jpg",
    "48": "logo.jpg",
    "128": "logo.jpg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mooky.live/*",
        "https://www.mooky.live/*"
      ],
      "css": [
        "style.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logo.jpg"
      ],
      "matches": [
        "https://mooky.live/*",
        "https://www.mooky.live/*"
      ]
    }
  ]
}
